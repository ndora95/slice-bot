# Copy to .env (git-ignored) to run the crew on Claude. Without a key, the rules engine runs.
ANTHROPIC_API_KEY=
# Only if your key isn't scoped to a workspace (the API says so): the workspace ID from the Console
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Optional: override the model
# SLICEBOT_MODEL=claude-opus-5-5
